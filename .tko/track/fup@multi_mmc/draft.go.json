            "content": "package main\n\nimport \"fmt\"\n\nfunc mdc(a, b int) int {\n    for b != 0 {\n        a, b = b, a%b\n    }\n    return a\n}\n\nfunc mmc(a, b int) int {\n    return a / mdc(a, b) * b\n}\n\nfunc mmcVetor(v []int) int {\n    resp := v[0]\n    for i := 1; i < len(v); i++ {\n        resp = mmc(resp, v[i])\n    }\n    return resp\n}\n",
